_remove_obsolete_fan_env_config() {
  local conf="/etc/pulsemon/pulsemon-api.conf"
  if [[ ! -f "${conf}" ]]; then
    return 0
  fi

  sed -i \
    -e '/^# Fans configuration and reference catalog$/d' \
    -e '/^STATS_FANS_MAPPING_FILE=/d' \
    -e '/^STATS_FANS_REFERENCE_SEED_FILE=/d' \
    "${conf}"
}

post_install() {
  cat <<'EOF_MSG'
PulseMon API installed.

Service management:
  sudo systemctl daemon-reload
  sudo systemctl enable --now pulsemon-api.service

Configuration file:
  /etc/pulsemon/pulsemon-api.conf
EOF_MSG
}

post_upgrade() {
  _remove_obsolete_fan_env_config
  post_install
  cat <<'EOF_MSG'

Legacy FAN mapping and SQLite files are no longer used and were not deleted automatically.
EOF_MSG
}

post_remove() {
  cat <<'EOF_MSG'
PulseMon API removed.

If still enabled:
  sudo systemctl disable --now pulsemon-api.service
EOF_MSG
}
